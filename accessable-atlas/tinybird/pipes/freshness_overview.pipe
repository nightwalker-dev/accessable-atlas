DESCRIPTION >
    Aggregates venue freshness states and observation activity by category over the last 30 days.

NODE freshness_counts
SQL >
    %
    SELECT
        category,
        freshness_state,
        count() AS event_count
    FROM atlas_events
    WHERE timestamp >= now() - INTERVAL 30 DAY
      AND workspace_slug = {{String(workspace_slug, 'metro-civic-access')}}
    GROUP BY category, freshness_state
    ORDER BY category ASC, event_count DESC

